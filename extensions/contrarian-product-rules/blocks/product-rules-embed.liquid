{% comment %}
  Contrarian Product Rules storefront embed.

  Product rule storefront embed. Checkout and shipping enforcement are not
  implemented in this phase.
{% endcomment %}

{%- liquid
  assign cpr_is_product_page = false
  assign cpr_rules = blank
  assign cpr_legacy_pickup_only = false

  if request.page_type == 'product' and product != blank
    assign cpr_is_product_page = true
    assign cpr_rules = product.metafields.contrarian_product_rules.rules.value
    assign cpr_legacy_pickup_only = product.metafields.custom.in_store_pickup_only.value
  endif
-%}

<div
  data-cpr-app
  data-cpr-version="1.0.0"
  data-cpr-debug="{{ block.settings.debug_mode }}"
  data-cpr-product-page="{{ cpr_is_product_page }}"
  {% if cpr_is_product_page %}
    data-cpr-product-id="{{ product.id }}"
    data-cpr-product-handle="{{ product.handle | escape }}"
  {% endif %}
  data-cpr-rules='{{ cpr_rules | default: blank | json | escape }}'
  data-cpr-legacy-pickup-only='{{ cpr_legacy_pickup_only | default: false | json | escape }}'
  hidden
></div>

{% schema %}
{
  "name": "Contrarian Product Rules",
  "target": "body",
  "javascript": "product-rules.js",
  "stylesheet": "product-rules.css",
  "settings": [
    {
      "type": "checkbox",
      "id": "debug_mode",
      "label": "Enable debug mode",
      "default": false
    }
  ]
}
{% endschema %}