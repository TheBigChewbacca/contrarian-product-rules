            "deliveryOptions": [
              { "handle": "standard", "deliveryMethodType": "SHIPPING" },
              { "handle": "store-pickup", "deliveryMethodType": "PICK_UP" }
            ]
          }
        ]
      }
    },
    "output": { "operations": [] }
  }
}
