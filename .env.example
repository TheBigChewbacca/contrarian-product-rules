# Local development environment.
#
# In production every one of these comes from Secret Manager and is wired into
# the Cloud Run service by .github/workflows/deploy.yml — do not set them by
# hand on the service. See docs/DEPLOY.md.

# --- Shopify ---------------------------------------------------------------
# From the Partner Dashboard app. `shopify app dev` injects these locally, so
# you usually only need them when running a production-style build by hand.
SHOPIFY_API_KEY=""
SHOPIFY_API_SECRET=""

# Public origin of the app. Must exactly match `application_url` in
# shopify.app.toml and the redirect URLs registered with Shopify.
SHOPIFY_APP_URL="https://contrarian-product-rules-198806279895.us-west1.run.app"

# Comma-separated. The app unions these with its own required scopes at
# startup (see app/shopify.server.ts), so this is additive, not authoritative.
SCOPES="read_products,write_products,read_orders,write_orders,read_shipping,write_shipping,read_merchant_managed_fulfillment_orders,write_merchant_managed_fulfillment_orders"

# Optional: only set when testing against a store on a custom domain.
# SHOP_CUSTOM_DOMAIN=""

# --- Database (Neon Postgres) ----------------------------------------------
# DATABASE_URL is the POOLED endpoint (host contains "-pooler") — this is what
# the running app uses, because Cloud Run scales to many short-lived instances.
# DIRECT_URL is the NON-pooled endpoint, used only for `prisma migrate`.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DATABASE?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DATABASE?sslmode=require"

# --- Runtime ---------------------------------------------------------------
NODE_ENV="development"

# --- Database load / Neon autosuspend --------------------------------------
# Neon bills compute by uptime and only autosuspends after 5 minutes idle, so
# a steady trickle of session/settings reads keeps it awake and billing. These
# bound the process-local caches that absorb those repeated reads. All are
# optional; the defaults below are what the code uses when unset.
#
# Sessions are cached per process and never past their own `expires`.
# SESSION_CACHE_TTL_MS=1800000
# ShopSettings (pickup profile, preorder collection) per shop.
# SHOP_SETTINGS_CACHE_TTL_MS=1800000
# Last reconciled product tag state, used to drop no-op product webhooks.
# PRODUCT_TAG_STATE_CACHE_TTL_MS=1800000

# TEMPORARY. Logs one line per products/create|update delivery (product ID,
# payload updated_at, tag signature, whether it was skipped) to identify what
# is generating product updates roughly once a minute. Set to "false" to
# silence it; remove the logging from
# app/lib/product-rule-tag-webhook.server.ts once the source is known.
# PRODUCT_WEBHOOK_DEBUG_LOG=false

# Cloud Run injects PORT itself; only set this locally if 3000 is taken.
# PORT=3000
