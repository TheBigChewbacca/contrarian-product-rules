{% comment %}
  Optional product-page notice block for Contrarian Product Rules.
  Pickup-only display logic will be added after the scaffold is verified.
{% endcomment %}

{% liquid
  assign rules = product.metafields.contrarian_product_rules.rules.value

  if rules
    assign pickup_rule = rules.pickup_only
    assign preorder_rule = rules.preorder
  endif
%}

{% if preorder_rule and preorder_rule.enabled %}
  <div
    class="cpr-notice cpr-notice--preorder"
    data-cpr-notice
    data-cpr-rule="preorder"
    {% if preorder_rule.releaseDate != blank %}
      data-release-date="{{ preorder_rule.releaseDate }}"
    {% endif %}
    {{ block.shopify_attributes }}
  >

    {% if preorder_rule.badgeText != blank %}
      <div class="cpr-badge">
        {{ preorder_rule.badgeText }}
      </div>
    {% endif %}

    {% if preorder_rule.message != blank %}
      <p class="cpr-message">
        {{ preorder_rule.message }}
      </p>
    {% endif %}

    {% if preorder_rule.releaseDate != blank %}
      <p class="cpr-release-date">
        Release Date: {{ preorder_rule.releaseDate }}
      </p>
    {% endif %}

    {% if preorder_rule.showCountdown %}
      <div
        class="cpr-countdown"
        data-cpr-countdown
      ></div>
    {% endif %}
  </div>

{% elsif pickup_rule and pickup_rule.enabled %}

  <div
    class="cpr-notice cpr-notice--pickup"
    data-cpr-notice
    data-cpr-rule="pickup-only"
    {{ block.shopify_attributes }}
  >
    <p class="cpr-message">
      {{ pickup_rule.message }}
    </p>
  </div>

{% endif %}

{% schema %}
{
  "name": "Product rule notice",
  "target": "section",
  "templates": ["product"],
  "settings": []
}
{% endschema %}
