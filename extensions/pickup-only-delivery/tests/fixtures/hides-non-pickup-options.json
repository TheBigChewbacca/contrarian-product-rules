          },
          {
            "cartLines": [
              { "merchandise": { "__typename": "ProductVariant", "product": { "pickupOnly": false } } }
            ],
            "deliveryOptions": [
              { "handle": "standard-2", "deliveryMethodType": "SHIPPING" }
